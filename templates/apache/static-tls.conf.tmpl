<VirtualHost *:443>
    ServerName {{ .PrimaryDomain }}
{{- range .Aliases }}
    ServerAlias {{ . }}
{{- end }}

    SSLEngine on
    SSLCertificateFile {{ .CertificateFile }}
    SSLCertificateKeyFile {{ .CertificateKey }}

    DocumentRoot {{ .DocumentRoot }}
    <Directory "{{ .DocumentRoot }}">
        Options -Indexes +FollowSymLinks
        AllowOverride None
        Require all granted
    </Directory>

    ErrorLog {{ .LogDir }}/ssl-error.log
    CustomLog {{ .LogDir }}/ssl-access.log combined
</VirtualHost>
