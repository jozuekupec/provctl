# ============================================================
# GENERATED BY PROVCTL — DO NOT EDIT
# subscription: {{ .Subscription }}
# website:      {{ .PrimaryDomain }}
# ============================================================
<VirtualHost *:80>
    ServerName {{ .PrimaryDomain }}
{{- range .Aliases }}
    ServerAlias {{ . }}
{{- end }}

    DocumentRoot {{ .DocumentRoot }}

    Alias /.well-known/acme-challenge/ {{ .AcmeChallengeRoot }}/.well-known/acme-challenge/
    <Directory "{{ .AcmeChallengeRoot }}/.well-known/acme-challenge">
        Require all granted
        Options None
        AllowOverride None
    </Directory>

{{- if .ForceHTTPS }}
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteRule ^ https://%{SERVER_NAME}%{REQUEST_URI} [R=301,L]
{{- else }}
    <Directory "{{ .DocumentRoot }}">
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

    <FilesMatch \.php$>
        SetHandler "proxy:unix:{{ .FPMSocket }}|fcgi://localhost"
    </FilesMatch>
    <Proxy "fcgi://localhost">
        ProxySet timeout={{ .ProxyTimeout }}
    </Proxy>
{{- end }}

    ErrorLog {{ .LogDir }}/error.log
    CustomLog {{ .LogDir }}/access.log combined
</VirtualHost>
