# ============================================================
# GENERATED BY PROVCTL — DO NOT EDIT
# subscription: acme
# website:      example.test
# ============================================================
<VirtualHost *:80>
    ServerName example.test
    ServerAlias www.example.test

    DocumentRoot /var/www/vhosts/acme/sites/example.test/public

    Alias /.well-known/acme-challenge/ /var/lib/provctl/acme-challenge/.well-known/acme-challenge/
    <Directory "/var/lib/provctl/acme-challenge/.well-known/acme-challenge">
        Require all granted
        Options None
        AllowOverride None
    </Directory>
    <Directory "/var/www/vhosts/acme/sites/example.test/public">
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

    <FilesMatch \.php$>
        SetHandler "proxy:unix:/run/php/provctl-acme.sock|fcgi://localhost"
    </FilesMatch>
    <Proxy "fcgi://localhost">
        ProxySet timeout=60
    </Proxy>

    ErrorLog /var/log/provctl/acme/example.test/error.log
    CustomLog /var/log/provctl/acme/example.test/access.log combined
</VirtualHost>
